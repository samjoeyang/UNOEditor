{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UNOEditor",
  "version": "0.1.6",
  "identifier": "com.unoeditor.app",
  "build": {
    "beforeDevCommand": "python3 -m http.server 5173",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "test -f copy-dist.sh && sh copy-dist.sh || sh ../copy-dist.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "UNOEditor",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["unoeditor"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installerHooks": "./hooks/installer.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
